# Godot 4 .gitignore
.godot/
*.translation
*.import

# Mono/C# (not used, but good hygiene)
.mono/
*.csproj
*.sln

# Export artifacts
/build/android/*.apk
/build/android/*.aab
/build/android/*.idsig
/build/android/*.pck
/build/desktop/*.pck
/build/desktop/TomorrowsYou.x86_64
/build/desktop/TomorrowsYou.sh

# OS files
.DS_Store
Thumbs.db


# Private signing material and nested public-release build artifacts
*.keystore
*.jks
*.p12
*.pfx
export_credentials.cfg
/build/android/releases/

# Python tooling caches
__pycache__/
*.pyc
