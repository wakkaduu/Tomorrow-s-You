; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but for this task it is configured cleanly according to Godot 4 specifications.

config_version=5

[application]

config/name="Tomorrow's You"
config/description="Every failed attempt becomes your teammate."
config/version="1.3.0"
config/icon="res://icon.svg"
run/main_scene="res://scenes/boot/boot.tscn"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color=Color(0.0431373, 0.0627451, 0.12549, 1)

[autoload]

SaveManager="*res://scripts/autoload/save_manager.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
GameManager="*res://scripts/autoload/game_manager.gd"
SceneRouter="*res://scripts/autoload/scene_router.gd"
AndroidSystemManager="*res://scripts/autoload/android_system_manager.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

